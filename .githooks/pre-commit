#!/bin/sh
# Fast local sensors before a commit — the static half of CI (lint + Prettier
# on the staged files + typecheck + dependency-cruiser layering rules + the
# native bridge check), so failures surface here instead of
# after a push. The slower coverage suite runs in pre-push; the full matrix
# runs in CI.
# Install: git config core.hooksPath .githooks (done automatically by the
# package.json "prepare" script on `npm install`).
#
# No-op in CI: the CI jobs run these checks as explicit steps, and the
# claude-autofix agent commits from inside a CI job (`npm ci`, then commit) —
# the hook must not fire on its commits.
[ -n "$CI" ] && exit 0

set -e
echo "▶ pre-commit: lint"
npm run lint
echo "▶ pre-commit: format (staged files)"
# Only what this commit stages; CI checks the whole tree. --ignore-unknown
# skips files Prettier can't parse (Swift, images), and .prettierignore
# still applies to the paths named here.
git diff --cached --name-only --diff-filter=ACMR -z |
  xargs -0 -r npx prettier --check --ignore-unknown
echo "▶ pre-commit: typecheck"
npm run typecheck
echo "▶ pre-commit: depcruise"
npm run depcruise
echo "▶ pre-commit: native bridge"
npm run -s bridge
