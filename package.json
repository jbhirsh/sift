{
  "name": "siftrn",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "typecov": "node --max-old-space-size=6144 node_modules/type-coverage/bin/type-coverage",
    "typecov:strict": "node --max-old-space-size=6144 node_modules/type-coverage/bin/type-coverage --strict --at-least 0",
    "depcruise": "depcruise src",
    "bridge": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-native-bridge.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run typecov && npm run depcruise && npm run bridge && npm run test:coverage",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "//pins": [
    "@types/react: ~ keeps the types on the React minor Expo SDK 58 pins react to (19.3.0). A newer @types/react minor declares what that React lacks (19.3 added ViewTransition and addTransitionType, which 19.2 never exported), so code using it would typecheck and get undefined at run time, and expo-doctor flags a minor the SDK does not expect (~19.3.0). Move it with each Expo SDK upgrade that moves react.",
    "typescript: listed in expo.install.exclude. Expo SDK 58 expects typescript ~6.0.3, but the name is an alias of @typescript/typescript6 (the 6.0 API typescript-eslint, dependency-cruiser and type-coverage need; see the typescript ignore in .github/dependabot.yml), whose latest release is 6.0.2, so expo install --check and expo-doctor would report it forever. Delete the exclude once @typescript/typescript6 reaches 6.0.3 or the alias goes."
  ],
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@sentry/react-native": "~8.28.0",
    "expo": "~58.0.20",
    "expo-asset": "~58.0.18",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.16",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linear-gradient": "~58.0.3",
    "expo-musickit": "file:modules/expo-musickit",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-updates": "~58.0.18",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@react-native/jest-preset": "^0.88.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "jest-runner": "^30.5.2",
    "jscpd": "^5.4.2",
    "knip": "^6.43.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "sf-symbols-typescript": "^2.2.0",
    "test-renderer": "^1.3.0",
    "type-coverage": "^2.30.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    },
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage",
        "typescript"
      ]
    }
  },
  "private": true,
  "typeCoverage": {
    "project": "tsconfig.typecov.json",
    "atLeast": 100,
    "ignoreCatch": true,
    "detail": true
  }
}
