{
  "mutation": {
    "wiring": [
      "stryker.conf.*",
      "stryker.config.*",
      "jest.config*",
      "jest.setup*",
      "babel.config.*",
      ".babelrc*",
      "__tests__/helpers/*.setup.ts",
      "package.json",
      "package-lock.json",
      "patches/**",
      ".github/workflows/mutation.yml",
      "scripts/stryker-jest-runner.ts",
      "__tests__/unit/strykerJestRunner.test.ts"
    ],
    "smoke": ["src/utils/formatTime.ts", "src/utils/sorting.ts", "src/utils/trackIdentity.ts"],
    "perFileThreshold": 80,
    "nodeOptions": "--disable-warning=MODULE_TYPELESS_PACKAGE_JSON",
    "sweep": {
      "shards": 8,
      "timeoutMinutes": 120
    }
  },
  "semgrep": {
    "paths": ["src", "__tests__", "modules", "index.ts"]
  },
  "visuals": {
    "ui": [
      "src/App.tsx",
      "src/components/**/*.{ts,tsx}",
      "src/screens/**/*.{ts,tsx}",
      "src/theme/**/*.{ts,tsx}",
      "assets/**"
    ],
    "notUi": [],
    "sharedTemplate": true
  },
  "audit": {
    "graph": ["src"]
  },
  "readme-screenshots": {
    "source": "the iOS Simulator shots CI's Screenshots and GIFs job took (mock library)"
  },
  "gif": {
    "source": "ci-videos",
    "scenarios": "e2e/gifs",
    "cellWidth": 260,
    "videos": {
      "workflow": "ci.yml",
      "artifact": "ios-gif-videos",
      "inputs": {
        "gifs_only": "true"
      },
      "scenariosInput": "gif_scenarios_from",
      "ringColor": "#E11D48"
    }
  },
  "visual-review": {
    "workflow": "ci.yml",
    "job": "Screenshots and GIFs",
    "folders": ["build/visual-shots"],
    "columns": [
      {
        "label": "Light",
        "file": "light-{state}.png",
        "width": 220
      },
      {
        "label": "Dark",
        "file": "dark-{state}.png",
        "width": 220
      }
    ],
    "mockupPaths": ["src/**", "assets/**", "e2e/screenshots/screens.yaml"]
  },
  "review": {
    "instructions": ".github/claude-review.md",
    "engine": "sdk",
    "advisor": "opus",
    "skipBots": ["dependabot[bot]"]
  },
  "autofix": {
    "engine": "sdk",
    "advisor": "opus",
    "ciFixChecks": [
      "`npm run check` (what CI's unit job runs: lint, format check, typecheck, type coverage, depcruise, the native bridge check, tests with coverage; `npm run format` rewrites what the format check flags)",
      "`npm audit --omit=dev --audit-level=critical`"
    ],
    "cannotRun": ["E2E (Maestro, on macOS)", "the iOS simulator build", "mutation testing"],
    "exempt": {
      "PR visuals": "Passes every PR: visual review decides (visuals.sharedTemplate).",
      "README screenshots": "Runs as a PR closes, when there's nothing left for autofix to do.",
      "Visual review": "Runs from main after CI and on description and auto-merge events, and fails only on what a person decides (a changed screen on a PR that merges itself), which no code change gives."
    }
  }
}
